ENVIRONMENT=development
APP_NAME=MediCORE
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=catalog-pdfs
DATABASE_URL=postgresql+psycopg://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password
# For Railway/Vercel production, use Supabase Transaction Pooler instead of direct db.*:5432.
SUPABASE_POOLER_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER=postgres.your-project-ref

# Valkey is Redis-protocol compatible. Use VALKEY_URL for new deployments.
# Local Docker Compose default:
VALKEY_PASSWORD=replace-with-a-long-random-password
VALKEY_URL=redis://:replace-with-a-long-random-password@valkey:6379/0
# Legacy fallback for old local setups if VALKEY_URL is not set:
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MediCORE
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

EMAIL_MODE=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=supplier-inbox@example.com
IMAP_PASSWORD=app-password-or-oauth-token
IMAP_MAILBOX=INBOX

GMAIL_WEBHOOK_TOKEN=change-me
GMAIL_OAUTH_TOKEN=oauth-access-token
GMAIL_USER_ID=me
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PUBSUB_TOPIC=gmail-supplier-topic

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
# Production frontend on Vercel should point at the Railway API/WS URLs below:
# NEXT_PUBLIC_API_URL=https://backend-production-b29e.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://backend-production-b29e.up.railway.app/ws/chat
MOCK_DATA_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_SENDER=your_gmail_address@gmail.com
